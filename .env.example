# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会进入版本库
# 命名规则：OFFICE_AGENT_ + YAML 路径，双下划线 __ 表示嵌套层级
# 例如 llm.api_key -> OFFICE_AGENT_LLM__API_KEY

# LLM API 密钥（必填项之一，阶段二约定的 OpenAI 兼容接口）
OFFICE_AGENT_LLM__API_KEY=sk-your-key-here

# 可选项：临时覆盖 YAML 中的默认配置（调试时很有用）
# OFFICE_AGENT_APP__LOG_LEVEL=DEBUG
# OFFICE_AGENT_LLM__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OFFICE_AGENT_LLM__MODEL=qwen-plus
